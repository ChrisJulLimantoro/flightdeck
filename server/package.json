{
  "name": "flightdeck",
  "version": "1.0.0",
  "description": "Flight Deck — local dual-engine PR + agent-state dashboard",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "flightdeck": "bin/flightdeck.js"
  },
  "files": [
    "bin",
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.js",
    "start": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.232",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/serve-static": "^5.0.5",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@flightdeck/shared": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
